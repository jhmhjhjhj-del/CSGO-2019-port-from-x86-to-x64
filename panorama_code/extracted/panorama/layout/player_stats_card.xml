<root>
	<styles>
		<include src="file://{resources}/styles/csgostyles.css" />
		<include src="file://{resources}/styles/player_stats_card.css" />
	</styles>

	<snippets>
		<snippet name="snippet-banner-classic">
			<Panel class="banner-classic">
				<Panel id="JsBannerBG" class="banner-bg colorize-teammate-color" />
				<Panel class="banner__stat-container">
					<Panel class="banner__stat adr">
						<Label class="value adr sliding-panel" text="#playercardstats_adr_value" />
						<Label class="desc adr colorize-teammate-color" text="#playercardstats_adr_title" />
					</Panel>
					<Panel class="banner__stat kda">
						<Label class="value kda sliding-panel" text="#playercardstats_kda_value" />
						<Label class="desc kda colorize-teammate-color" text="#playercardstats_kda_title" />
					</Panel>
					<Panel class="banner__stat hsp">
						<Label class="value hsp sliding-panel" text="#playercardstats_hsp_value" />
						<Label class="desc hsp colorize-teammate-color" text="#playercardstats_hsp_title" />
					</Panel>
				</Panel>
			</Panel>
		</snippet>
		<snippet name="snippet-banner-dm">
			<Panel class="banner-dm">
				<Panel id="JsBannerBG" class="banner-bg colorize-teammate-color" />
				<Panel class="banner__stat-container">
					<Panel class="banner__stat score">
						<Label class="value sliding-panel" text="#playercardstats_score_value" />
						<Label class="desc colorize-teammate-color" text="#playercardstats_score_title" />
					</Panel>
					<Panel class="banner__stat kills">
						<Label class="value sliding-panel" text="#playercardstats_k_value" />
						<Label class="desc colorize-teammate-color" text="#playercardstats_k_title" />
					</Panel>
					<Panel class="banner__stat hsp">
						<Label class="value sliding-panel" text="#playercardstats_hsp_value" />
						<Label class="desc colorize-teammate-color" text="#playercardstats_hsp_title" />
					</Panel>
					<Panel class="banner__stat deaths">
						<Label class="value sliding-panel" text="#playercardstats_d_value" />
						<Label class="desc colorize-teammate-color" text="#playercardstats_d_title" />
					</Panel>
				</Panel>
			</Panel>
		</snippet>
		<snippet name="snippet-banner-ar">
			<Panel class="banner-ar">
				<Panel id="JsBannerBG" class="banner-bg colorize-teammate-color" />
				<Panel class="banner__stat-container">
					<Panel class="banner__stat gglevel">
						<Label class="value sliding-panel" text="#playercardstats_gglevel_value" />
						<Label class="desc colorize-teammate-color" text="#playercardstats_gglevel_title" />
					</Panel>
					<Panel class="banner__stat kills">
						<Label class="value sliding-panel" text="#playercardstats_kk_value" />
						<Label class="desc colorize-teammate-color" text="#playercardstats_kk_title" />
					</Panel>
					<Panel class="banner__stat hsp">
						<Label class="value sliding-panel" text="#playercardstats_hsp_value" />
						<Label class="desc colorize-teammate-color" text="#playercardstats_hsp_title" />
					</Panel>
					<Panel class="banner__stat deaths">
						<Label class="value sliding-panel" text="#playercardstats_d_value" />
						<Label class="desc colorize-teammate-color" text="#playercardstats_d_title" />
					</Panel>
				</Panel>
			</Panel>
		</snippet>
	</snippets>

	<Panel class="card-root">
		<Panel id="JsBanner" class="card__banner" />
		<Panel class="card__inset">
			<Panel id="JsCardBG" class="card__bg" />
			<Panel class="card__border colorize-teammate-color" />
			<Panel class="card__contents">
				<Panel id="JsCardMain" class="card__main">
					<Panel class="card__avatar-container">
						<CSGOAvatarImage id="jsAvatar" class="card__avatar" scaling="stretch-to-fit-y-preserve-aspect" />
					</Panel>
					<Panel class="emblem--skillgroup">
						<Image id="jsSkillGroupImage" textureheight="-1" texturewidth="48" src="" />
					</Panel>
					<Panel class="card__main__lower">
						<Panel class="card__player-name sliding-panel">
							<Label class="card__player-name-label" html="true" text="{s:player_name}" />
						</Panel>
						<Panel class="divider" />
						<Panel class="card__accolade-container sliding-panel">
							<Label class="title" text="{s:accolade-the-title}" />
							<Label class="detail" text="{s:accolade-desc} {s:accolade-value}" />
						</Panel>
					</Panel>
				</Panel>
			</Panel>
			<Panel class="emblem--flair">
				<Image id="jsFlairImage" textureheight="-1" texturewidth="48" src="" />
			</Panel>
		</Panel>
	</Panel>
</root>
